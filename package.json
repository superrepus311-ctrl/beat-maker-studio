{
  "name": "beat-maker-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based beat maker production studio: React + Tone.js, Vite + TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0 || true",
    "typecheck": "tsc --noEmit",
    "start": "npm run dev"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tone": "^14.7.77"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0"
  }
}
